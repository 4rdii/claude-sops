#!/usr/bin/env bash
set -euo pipefail

# List all secret keys (not values) across both tiers.

SOPS_DIR="${CLAUDE_SOPS_DIR:-$HOME/.claude-sops}"

echo "=== Tier 1 (Standard — Claude can decrypt) ==="
TIER1="$SOPS_DIR/secrets/tier1.env.sops"
if [[ -f "$TIER1" ]]; then
    sops --input-type dotenv --output-type dotenv -d "$TIER1" 2>/dev/null | \
        grep -v '^#' | grep -v '^$' | cut -d= -f1 | while read -r key; do
        echo "  $key"
    done
else
    echo "  (none)"
fi

echo ""
echo "=== Tier 2 (Zero-Knowledge — proxy only) ==="
TIER2="$SOPS_DIR/secrets/tier2.env.sops"
if [[ -f "$TIER2" ]]; then
    sops --input-type dotenv --output-type dotenv -d "$TIER2" 2>/dev/null | \
        grep -v '^#' | grep -v '^$' | cut -d= -f1 | while read -r key; do
        echo "  $key"
    done
else
    echo "  (none)"
fi
