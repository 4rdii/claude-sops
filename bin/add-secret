#!/usr/bin/env bash
set -euo pipefail

# Add or update a secret in the SOPS-encrypted store.
# Usage: add-secret [--tier 1|2] <KEY> <VALUE>

SOPS_DIR="${CLAUDE_SOPS_DIR:-$HOME/.claude-sops}"
TIER=1

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tier) TIER="$2"; shift 2 ;;
        *) break ;;
    esac
done

KEY="${1:-}"
VALUE="${2:-}"

if [[ -z "$KEY" || -z "$VALUE" ]]; then
    echo "Usage: add-secret [--tier 1|2] <KEY> <VALUE>" >&2
    exit 1
fi

# Sanitize key name
SAFE_KEY=$(echo "$KEY" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')

if [[ "$TIER" == "1" ]]; then
    SECRETS_FILE="$SOPS_DIR/secrets/tier1.env"
    ENCRYPTED_FILE="$SOPS_DIR/secrets/tier1.env.sops"
elif [[ "$TIER" == "2" ]]; then
    SECRETS_FILE="$SOPS_DIR/secrets/tier2.env"
    ENCRYPTED_FILE="$SOPS_DIR/secrets/tier2.env.sops"
else
    echo "Invalid tier: $TIER (must be 1 or 2)" >&2
    exit 1
fi

# Decrypt existing file or create new
if [[ -f "$ENCRYPTED_FILE" ]]; then
    sops --input-type dotenv --output-type dotenv -d "$ENCRYPTED_FILE" > "$SECRETS_FILE" 2>/dev/null
else
    echo "# claude-sops tier $TIER secrets" > "$SECRETS_FILE"
fi

# Add/update key (remove old entry if exists, then append)
grep -v "^${SAFE_KEY}=" "$SECRETS_FILE" > "${SECRETS_FILE}.tmp" 2>/dev/null || true
echo "${SAFE_KEY}=${VALUE}" >> "${SECRETS_FILE}.tmp"
mv "${SECRETS_FILE}.tmp" "$SECRETS_FILE"

# Encrypt
sops --input-type dotenv --output-type dotenv -e "$SECRETS_FILE" > "$ENCRYPTED_FILE"
rm -f "$SECRETS_FILE"
chmod 600 "$ENCRYPTED_FILE"

echo "Secret '$SAFE_KEY' saved to Tier $TIER store."
if [[ "$TIER" == "1" ]]; then
    echo "  Claude can decrypt this with: sops --input-type dotenv --output-type dotenv -d $ENCRYPTED_FILE"
elif [[ "$TIER" == "2" ]]; then
    echo "  This secret is only accessible via the proxy. Claude never sees the value."
fi
