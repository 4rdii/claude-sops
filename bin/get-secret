#!/usr/bin/env bash
set -euo pipefail

# Get a single Tier 1 secret value.
# Usage: get-secret <KEY>
# NOTE: This outputs the secret value — if called by Claude, the LLM server sees it.

SOPS_DIR="${CLAUDE_SOPS_DIR:-$HOME/.claude-sops}"
KEY="${1:-}"

if [[ -z "$KEY" ]]; then
    echo "Usage: get-secret <KEY>" >&2
    exit 1
fi

SAFE_KEY=$(echo "$KEY" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')
ENCRYPTED_FILE="$SOPS_DIR/secrets/tier1.env.sops"

if [[ ! -f "$ENCRYPTED_FILE" ]]; then
    echo "No Tier 1 secrets found." >&2
    exit 1
fi

VALUE=$(sops --input-type dotenv --output-type dotenv -d "$ENCRYPTED_FILE" 2>/dev/null | grep "^${SAFE_KEY}=" | head -1 | cut -d= -f2-)

if [[ -z "$VALUE" ]]; then
    echo "Secret '$SAFE_KEY' not found in Tier 1 store." >&2
    exit 1
fi

echo "$VALUE"
