#!/usr/bin/env bash
set -euo pipefail

# Remove a secret from the store.
# Usage: remove-secret <KEY>

SOPS_DIR="${CLAUDE_SOPS_DIR:-$HOME/.claude-sops}"
KEY="${1:-}"

if [[ -z "$KEY" ]]; then
    echo "Usage: remove-secret <KEY>" >&2
    exit 1
fi

SAFE_KEY=$(echo "$KEY" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')

for tier in 1 2; do
    ENCRYPTED_FILE="$SOPS_DIR/secrets/tier${tier}.env.sops"
    [[ -f "$ENCRYPTED_FILE" ]] || continue

    TEMP_FILE=$(mktemp)
    sops --input-type dotenv --output-type dotenv -d "$ENCRYPTED_FILE" 2>/dev/null > "$TEMP_FILE"

    if grep -q "^${SAFE_KEY}=" "$TEMP_FILE"; then
        grep -v "^${SAFE_KEY}=" "$TEMP_FILE" > "${TEMP_FILE}.env.new"
        # Check if any secrets remain
        if grep -q '=' "${TEMP_FILE}.env.new" 2>/dev/null && [ -s "${TEMP_FILE}.env.new" ]; then
            sops --input-type dotenv --output-type dotenv -e "${TEMP_FILE}.env.new" > "$ENCRYPTED_FILE"
        else
            # No secrets left, remove the store file
            rm -f "$ENCRYPTED_FILE"
        fi
        rm -f "$TEMP_FILE" "${TEMP_FILE}.env.new"
        echo "Removed '$SAFE_KEY' from Tier $tier."
        exit 0
    fi
    rm -f "$TEMP_FILE"
done

echo "Secret '$SAFE_KEY' not found in any tier." >&2
exit 1
