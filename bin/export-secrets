#!/usr/bin/env bash
set -euo pipefail

# Export all Tier 1 secrets as plaintext .env
# WARNING: This outputs secrets in plaintext. Use carefully.

SOPS_DIR="${CLAUDE_SOPS_DIR:-$HOME/.claude-sops}"
TIER1="$SOPS_DIR/secrets/tier1.env.sops"

if [[ ! -f "$TIER1" ]]; then
    echo "No Tier 1 secrets found." >&2
    exit 1
fi

echo "# claude-sops Tier 1 secrets (plaintext export)"
echo "# Generated: $(date -Iseconds)"
echo "# WARNING: This file contains decrypted secrets. Delete after use."
echo ""
sops --input-type dotenv --output-type dotenv -d "$TIER1" 2>/dev/null | grep -v '^#'
